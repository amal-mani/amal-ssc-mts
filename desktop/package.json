{
  "name": "mts-study",
  "productName": "MTS Study",
  "version": "1.0.0",
  "description": "SSC MTS study app",
  "author": "Amal",
  "main": "main.js",
  "scripts": { "dist": "electron-builder --win nsis --x64 --publish never" },
  "devDependencies": { "electron": "33.4.11", "electron-builder": "25.1.8" },
  "build": {
    "appId": "com.amalmani.mtsstudy",
    "productName": "MTS Study",
    "files": ["main.js", "www/**", "build/icon.png"],
    "win": { "target": "nsis", "icon": "build/icon.png", "artifactName": "MTS-Study-Setup.exe" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "MTS Study" }
  }
}
